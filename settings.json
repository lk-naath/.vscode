        "**/data-files": true,
        "**/.next": true,
        "**/.python-version": true,
        "**/.coverage": true,
        "**/.coveragerc": true,
        "**/past-reports": true,
        "**/log": true,
        "**/logs": true,
        "**/dist": true,
