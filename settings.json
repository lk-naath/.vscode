        "**/.next": true,
        "**/.python-version": true,
        "**/.coverage": true,
        "**/.coveragerc": true,
        "**/past-reports": true,
        "**/log": true,
        "**/logs": true,
        "**/dist": true,
        "**/build": true,
        "**/vocore.egg-info": true,
        "**/.idea": true,
        "**/venv": true,
        "**/.venv": true,
        "**/htmlcov": true,
        "**/.mypy_cache": true,
        "**/.ci_output": true,
        "**/.yarn": true,
        "**/.env.*": true
    },

    "search.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/node_modules": true,
