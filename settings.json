{
    "python.defaultInterpreterPath": "/Users/uttam/.pyenv/versions/.mico/bin/python",
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.autoSearchPaths": true,
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.stubPath": "typings",
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/aos",
        "${workspaceFolder}/lingos",
        "${workspaceFolder}/typings",
        "${workspaceFolder}/aos/typings",
        "${workspaceFolder}/lingos/typings",
    ],
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none",
        "reportMissingTypeStubs": "warning"
    },
    "python.analysis.include": [
        "${workspaceFolder}/**/*.py",
        "${workspaceFolder}/**/*.pyi"
    ],
    "tree-sitter-vscode.debug": true,
    "tree-sitter-vscode.languageConfigs": [
        {
            "lang": "deeplingua",
            "parser": "/Users/uttam/Desktop/mico/tree-sitter-deeplingua/tree-sitter-deeplingua.wasm",
            "highlights": "/Users/uttam/Desktop/mico/tree-sitter-deeplingua/queries/highlights.scm"
        }
    ],
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": [],

    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/schema_files": true,
        "**/data-files": true,
        "**/.next": true,
        "**/.python-version": true,
        "**/.coverage": true,
        "**/.coveragerc": true,
        "**/past-reports": true,
        "**/.ruff_cache": true,
        "**/log": true,
        "**/logs": true,
        "**/dist": true,
        "**/build": true,
        "**/vocore.egg-info": true,
        "**/.idea": true,
        "**/venv": true,
        "**/.venv": true,
        "**/htmlcov": true,
        "**/.mypy_cache": true,
        "**/.ci_output": true,
        "**/.yarn": true,
        "**/.env.*": true
    },

    "search.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "**/schema_files": true,
        "**/data-files": true,
        "**/.next": true,
        "**/.python-version": true,
        "**/.coverage": true,
        "**/.coveragerc": true,
        "**/past-reports": true,
        "**/.ruff_cache": true,
        "**/log": true,
        "**/logs": true,
        "**/dist": true,
        "**/build": true,
        "**/vocore.egg-info": true,
        "**/certs": true,
        "**/.idea": true,
        "**/venv": true,
        "**/.venv": true,
        "**/htmlcov": true,
        "**/.mypy_cache": true,
        "**/.ci_output": true,
        "**/.yarn": true,
        "**/.env.*": true
    },

    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.DS_Store": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/node_modules/**": true,
        "**/schema_files/**": true,
        "**/data-files/**": true,
        "**/.next/**": true,
        "**/.python-version/**": true,
        "**/.coverage/**": true,
        "**/.coveragerc/**": true,
        "**/past-reports/**": true,
        "**/.ruff_cache/**": true,
        "**/log/**": true,
        "**/logs/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/vocore.egg-info/**": true,
        "**/certs/**": true,
        "**/.idea/**": true,
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/htmlcov/**": true,
        "**/.mypy_cache/**": true,
        "**/.ci_output/**": true,
        "**/.yarn/**": true,
        "**/.env.*/**": true
    },
    "activationEvents": [
        "onLanguage:deeplingua"
    ],
    "files.associations": {
        "*.lark": "lark",
        "*.txt": "markdown",
        "*.rego": "rego",
        "*.lingo": "deeplingua",
        "*.lingua": "deeplingua",
    },

    "lark.server.enabled": true,
    "lark.server.arguments": ["--log-level", "INFO"],
    "lark.server.trace": "off",

    "cSpell.words": [
        "regos",
        "asyncop",
        "mathjs",
        "MULTISELECTRECORDLOOKUP",
        "vocore",
        "Lekhnath",
        "Parajuli",
        "Vishu",
        "Mishra",
        "mico",
        "micore",
        "micoagent",
        "micoai",
        "micoid",
        "DEEP_SEEK_API_KEY",
        "GROQ_API_KEY",
        "GROK_API_KEY",
        "Agentify",
        "agikit",
        "lingos",
        "deeplingos"
    ],
    "python.REPL.enableREPLSmartSend": false
}
